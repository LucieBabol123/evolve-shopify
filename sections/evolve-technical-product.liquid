{%- liquid
  assign body_font = section.settings.typography_font | font_modify: 'weight', '400'
  assign subheading_font = body_font | font_modify: 'weight', '600'
  assign heading_font = body_font | font_modify: 'weight', '700'
-%}
{% style %}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ subheading_font | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
{% endstyle %}
{{ 'evolve-technical-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'evolve-technical-product.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_size_image = nil
  assign configured_size_count = 0
  for block in section.blocks
    if block.type == 'size_image' and block.settings.image != blank
      assign configured_size_count = configured_size_count | plus: 1
      if block.settings.enabled and first_size_image == nil
        assign first_size_image = block.settings.image
      endif
    endif
  endfor
  assign main_image = section.settings.image | default: first_size_image
  if configured_size_count == 0
    assign main_image = main_image | default: product.featured_image
  endif
  assign main_title = section.settings.heading | default: product.title
-%}
<div id="Evolve-{{ section.id }}" class="ev-tech" data-evolve-product style="--ev-bg:{{ section.settings.background }};--ev-panel:{{ section.settings.panel }};--ev-text:{{ section.settings.text_color }};--ev-muted:{{ section.settings.muted }};--ev-accent:{{ section.settings.accent }};--ev-line:{{ section.settings.line }};--ev-button:{{ section.settings.button_bg }};--ev-button-text:{{ section.settings.button_text }};--ev-font:{{ body_font.family | escape }}, {{ body_font.fallback_families | escape }};--ev-title:{{ section.settings.title_size }}px;--ev-title-mobile:{{ section.settings.mobile_title_size }}px;--ev-body:{{ section.settings.body_size }}px;--ev-label:{{ section.settings.label_size }}px;--ev-width:{{ section.settings.max_width }}px;--ev-padding:{{ section.settings.padding }}px;--ev-gap:{{ section.settings.gap }}px;--ev-radius:{{ section.settings.radius }}px;--ev-row:{{ section.settings.row_padding }}px;">
  <div class="ev-tech__layout">
    <div class="ev-tech__media{% if section.settings.show_grid %} ev-tech__media--grid{% endif %}">
      <div class="ev-tech__media-top"><span>{{ section.settings.eyebrow | escape }}</span><span class="ev-tech__marker" aria-hidden="true">＋</span></div>
      <div class="ev-tech__image-area">
        {% if main_image %}
          {{ main_image | image_url: width: 1600 | image_tag: class: 'ev-tech__image', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}
        {% else %}{{ 'product-1' | placeholder_svg_tag: 'ev-tech__image' }}{% endif %}
        {% if section.settings.show_hotspots %}
          {% for block in section.blocks %}
            {% if block.type == 'hotspot' and block.settings.enabled %}
              <details class="ev-tech__hotspot{% if block.settings.x > 50 %} ev-tech__hotspot--right{% endif %}{% if block.settings.y > 55 %} ev-tech__hotspot--bottom{% endif %}" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%;" {{ block.shopify_attributes }}>
                <summary aria-label="{{ block.settings.title | escape }}"><span aria-hidden="true">+</span></summary>
                <div class="ev-tech__tooltip"><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.body | escape | newline_to_br }}</p></div>
              </details>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
      {% if section.settings.show_gallery %}
        <div class="ev-tech__thumbs" aria-label="Product images">
          {% if configured_size_count > 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'size_image' and block.settings.enabled and block.settings.image != blank %}
                {% assign image = block.settings.image %}
                <button type="button" class="ev-tech__thumb ev-tech__thumb--size" data-image="{{ image | image_url: width: 1600 }}" data-srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1600 }} 1600w" data-alt="{{ image.alt | default: block.settings.label | escape }}" aria-label="Show {{ block.settings.label | escape }} pack image" aria-pressed="{% if image == main_image %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}<span>{{ block.settings.label | escape }}</span></button>
              {% endif %}
            {% endfor %}
          {% else %}
            {% for image in product.images limit: 6 %}
              <button type="button" class="ev-tech__thumb" data-image="{{ image | image_url: width: 1600 }}" data-srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1600 }} 1600w" data-alt="{{ image.alt | default: product.title | escape }}" aria-label="Show image {{ forloop.index }}" aria-pressed="{% if image == main_image %}true{% else %}false{% endif %}">{{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</button>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.image_caption != blank %}<div class="ev-tech__caption"><span class="ev-tech__dot" aria-hidden="true"></span>{{ section.settings.image_caption | escape }}<span aria-hidden="true">↗</span></div>{% endif %}
    </div>
    <div class="ev-tech__content">
      {% if section.settings.eyebrow != blank %}<div class="ev-tech__eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
      {% if section.settings.show_title %}<h2 class="ev-tech__title">{{ main_title | escape }}</h2>{% endif %}
      {% if section.settings.show_description %}<div class="ev-tech__description">{% if section.settings.intro != blank %}{{ section.settings.intro }}{% else %}{{ product.description }}{% endif %}</div>{% endif %}
      {% if section.settings.show_specs %}
        {% capture spec_rows %}
          {% for block in section.blocks %}
            {% if block.type == 'spec' and block.settings.enabled %}
              {%- liquid
                assign spec_value = block.settings.value
                if spec_value == blank and block.settings.metafield != blank
                  assign parts = block.settings.metafield | split: '.'
                  assign field = product.metafields[parts[0]][parts[1]]
                  if field.type contains 'list.'
                    assign spec_value = field.value | join: ', '
                  else
                    assign spec_value = field.value
                  endif
                endif
              -%}
              {% unless spec_value == blank and block.settings.hide_empty %}
                <div class="ev-tech__spec" {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ spec_value | escape | newline_to_br }}</dd></div>
              {% endunless %}
            {% endif %}
          {% endfor %}
        {% endcapture %}
        {% assign visible_rows = spec_rows | strip %}
        {% if visible_rows != blank %}
          <div class="ev-tech__spec-header"><h3>{{ section.settings.spec_heading | escape }}</h3><span aria-hidden="true">↗</span></div>
          <dl class="ev-tech__specs">{{ spec_rows }}</dl>
        {% endif %}
      {% endif %}
      {% if section.settings.show_download and section.settings.datasheet_url != blank %}
        <a class="ev-tech__download{% if section.settings.datasheet_style == 'button' %} ev-tech__download--button{% endif %}" href="{{ section.settings.datasheet_url | escape }}">{{ section.settings.datasheet_label | escape }} <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if section.settings.show_purchase or section.settings.show_price or section.settings.show_cart %}
        {% capture commerce_controls %}
          {% if section.settings.show_purchase or section.settings.show_cart %}
            <label for="EvolveVariant-{{ section.id }}">Select option</label>
            <select id="EvolveVariant-{{ section.id }}" name="id" data-ev-variant>
              {% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}"{% if variant == current_variant %} selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}
            </select>
          {% endif %}
          {% if section.settings.show_price %}<p class="ev-tech__price" data-ev-price aria-live="polite">{{ current_variant.price | money }}</p>{% endif %}
          {% if section.settings.show_cart %}
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="add" class="ev-tech__buy" data-ev-buy data-label="{{ section.settings.button_label | escape }}"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ section.settings.button_label | escape }}{% else %}Sold out{% endif %}</button>
          {% endif %}
        {% endcapture %}
        {% if section.settings.show_cart %}
          {% assign form_id = 'EvolveForm-' | append: section.id %}
          {% form 'product', product, id: form_id, class: 'ev-tech__form' %}
            {{ form.errors | default_errors }}
            {{ commerce_controls }}
          {% endform %}
        {% else %}
          <div class="ev-tech__form">{{ commerce_controls }}</div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Evolve technical product",
  "tag": "section",
  "class": "evolve-product-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Technical label",
      "default": "EVOLVE / LUBRICANT TECHNOLOGY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title override"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Description override"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image override"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_gallery",
      "label": "Show image thumbnails",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hotspots",
      "label": "Show hotspots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_specs",
      "label": "Show specification table",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_purchase",
      "label": "Show variant selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Add to cart",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show technical background grid",
      "default": true
    },
    {
      "type": "text",
      "id": "spec_heading",
      "label": "Specification heading",
      "default": "Technical data"
    },
    {
      "type": "checkbox",
      "id": "show_download",
      "label": "Show safety data sheet link",
      "default": true
    },
    {
      "type": "url",
      "id": "datasheet_url",
      "label": "Safety data sheet link (connect dynamic source)"
    },
    {
      "type": "text",
      "id": "datasheet_label",
      "label": "Safety data sheet link label",
      "default": "Safety Data Sheet"
    },
    {
      "type": "select",
      "id": "datasheet_style",
      "label": "Safety data sheet appearance",
      "default": "link",
      "options": [
        {
          "value": "link",
          "label": "Underlined link"
        },
        {
          "value": "button",
          "label": "Button"
        }
      ]
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "ENGINEERED FOR PERFORMANCE"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Purchase button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel",
      "label": "Image panel",
      "default": "#f3f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#151a16"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Secondary text",
      "default": "#626960"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#d2ef00"
    },
    {
      "type": "color",
      "id": "line",
      "label": "Borders and grid",
      "default": "#dce0d6"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#151a16"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography and layout"
    },
    {
      "type": "font_picker",
      "id": "typography_font",
      "label": "Section font",
      "default": "montserrat_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Desktop title size",
      "min": 24,
      "max": 64,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Mobile title size",
      "min": 20,
      "max": 40,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Technical label size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 11,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "default": 1400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Specification row padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification row",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show row",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Viscosity"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value (connect a product dynamic source)"
        },
        {
          "type": "text",
          "id": "metafield",
          "label": "Optional metafield namespace.key",
          "info": "Example: custom.viscosity. Used when Value is blank. Supports text, numbers and lists."
        },
        {
          "type": "checkbox",
          "id": "hide_empty",
          "label": "Hide when no value",
          "default": true
        }
      ],
      "limit": 8
    },
    {
      "type": "hotspot",
      "name": "Image hotspot",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show hotspot",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Performance detail"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Detail (supports dynamic sources)",
          "default": "Add a verified product benefit here."
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 65,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 40,
          "unit": "%"
        }
      ],
      "limit": 12
    },
    {
      "type": "size_image",
      "name": "Pack size image",
      "limit": 6,
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show pack size",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Pack size label",
          "default": "1L"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Pack image (supports dynamic sources)"
        }
      ]
    }
  ],
  "max_blocks": 26,
  "presets": [
    {
      "name": "Evolve technical product",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "label": "Viscosity"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Standards"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Approval"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Specifications"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Performances"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Application"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Quality"
          }
        },
        {
          "type": "hotspot"
        },
        {
          "type": "size_image",
          "settings": {
            "label": "1L"
          }
        },
        {
          "type": "size_image",
          "settings": {
            "label": "4L"
          }
        },
        {
          "type": "size_image",
          "settings": {
            "label": "5L"
          }
        },
        {
          "type": "size_image",
          "settings": {
            "label": "20L"
          }
        },
        {
          "type": "size_image",
          "settings": {
            "label": "60L"
          }
        },
        {
          "type": "size_image",
          "settings": {
            "label": "199L"
          }
        }
      ]
    }
  ]
}
{% endschema %}
